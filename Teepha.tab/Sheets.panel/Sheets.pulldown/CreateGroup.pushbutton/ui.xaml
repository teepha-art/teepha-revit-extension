<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ShowInTaskbar="False"
        Title="CREATE GROUP - Sheet Set Generator"
        Width="640" Height="640" MinWidth="560" MinHeight="420"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10">
            <Run Text="Expand a discipline and fill in its Sheet Group, a sample Sheet Number"/>
            <LineBreak/>
            <Run Text="(e.g. &quot;COR_P1_V2_AR-00&quot;), a Sheet Count, and a Title Block."/>
            <LineBreak/>
            <Run Text="Only expanded sections you fill in will be generated."/>
        </TextBlock>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button x:Name="add_discipline_btn" Content="+ Add discipline"
                    HorizontalAlignment="Left" Padding="10,4" Margin="0,0,0,10"
                    Click="add_discipline"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="cancel_btn" Content="Cancel" Width="90" Height="28"
                        Margin="0,0,10,0" Click="cancel_clicked"/>
                <Button x:Name="create_btn" Content="Create sheets" Width="120" Height="28"
                        Click="create_sheets"/>
            </StackPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="SectionsPanel"/>
        </ScrollViewer>
    </DockPanel>
</Window>
